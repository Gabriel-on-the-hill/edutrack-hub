generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  password      String
  role          UserRole     @default(STUDENT)
  phone         String?
  isActive      Boolean      @default(true)
  emailVerified Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  auditLogs     AuditLog[]   @relation("AuditActor")
  enrollments   Enrollment[]
  payments      Payment[]
  progress      Progress[]

  @@index([email])
  @@index([role])
}

model Class {
  id            String       @id @default(cuid())
  title         String
  description   String?
  subject       String
  level         ClassLevel   @default(BEGINNER)
  scheduledTime DateTime
  duration      Int
  timezone      String       @default("Africa/Lagos")
  maxStudents   Int          @default(10)
  price         Int          @default(0)
  currency      String       @default("NGN")
  meetUrl       String?
  meetingId     String?
  recordingUrl  String?
  notesUrl      String?
  status        ClassStatus  @default(SCHEDULED)
  topics        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  attendance    Attendance[]
  enrollments   Enrollment[]

  @@index([subject])
  @@index([level])
  @@index([scheduledTime])
  @@index([status])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  classId     String
  status      EnrollmentStatus @default(PENDING)
  enrolledAt  DateTime         @default(now())
  confirmedAt DateTime?
  completedAt DateTime?
  paymentId   String?
  rating      Int?
  feedback    String?
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
  @@index([userId])
  @@index([classId])
  @@index([status])
}

model Attendance {
  id         String    @id @default(cuid())
  classId    String
  userId     String
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  duration   Int?
  wasPresent Boolean   @default(true)
  class      Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([classId])
  @@index([userId])
}

model Progress {
  id               String     @id @default(cuid())
  userId           String
  subject          String
  classesEnrolled  Int        @default(0)
  classesAttended  Int        @default(0)
  classesCompleted Int        @default(0)
  totalMinutes     Int        @default(0)
  currentLevel     ClassLevel @default(BEGINNER)
  lastClassDate    DateTime?
  streak           Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject])
  @@index([userId])
  @@index([subject])
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  amount          Int
  currency        String        @default("NGN")
  stripePaymentId String?       @unique
  stripeSessionId String?
  status          PaymentStatus @default(PENDING)
  classId         String?
  description     String?
  createdAt       DateTime      @default(now())
  paidAt          DateTime?
  refundedAt      DateTime?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripePaymentId])
  @@index([status])
  @@index([createdAt])
}

model Curriculum {
  id                String       @id @default(cuid())
  country           String
  countryCode       String
  jurisdictionLevel String
  jurisdictionName  String?
  grade             String
  subject           String
  status            String       @default("active")
  confidenceScore   Float        @default(0.0)
  sourceUrl         String?
  sourceAuthority   String?
  lastVerified      DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  competencies      Competency[]

  @@index([countryCode])
  @@index([grade])
  @@index([subject])
  @@index([status])
}

model Competency {
  id           String     @id @default(cuid())
  curriculumId String
  title        String
  description  String
  orderIndex   Int        @default(0)
  pageRange    String?
  confidence   Float      @default(0.0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@index([curriculumId])
  @@index([orderIndex])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model Resource {
  id          String       @id @default(cuid())
  title       String
  description String?
  content     String?
  type        ResourceType
  subject     String
  level       ClassLevel   @default(BEGINNER)
  url         String?
  isPublished Boolean      @default(false)
  downloads   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([subject])
  @@index([isPublished])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  changes   String?
  metadata  String?
  createdAt DateTime @default(now())
  actor     User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

model Lead {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  source       String   @default("website")
  isSubscribed Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

enum UserRole {
  ADMIN
  STUDENT
}

enum ClassLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  ATTENDED
  COMPLETED
  MISSED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ResourceType {
  VIDEO
  PDF
  WORKSHEET
  ARTICLE
  GAME
  LESSON_PLAN
  QUIZ
  SUMMARY
}
